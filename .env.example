# พอร์ตเซิร์ฟเวอร์
PORT=3000

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Front-end Framework (LIFF)
LIFF_ID=

# Google Cloud Services / GAS Web App
GAS_WEBAPP_URL=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# ไทม์โซนระบบ
TIMEZONE=Asia/Bangkok

# กำหนดสิทธิ์ผู้ดูแลระบบ (Admin Access Control)
# ระบุ LINE User ID ของแอดมิน คั่นด้วยจุลภาค เช่น U123...,U456...
ADMIN_LINE_USER_IDS=
ADMIN_API_KEY=

# รหัสความปลอดภัยสำหรับ Cron Job Trigger (Vercel Cron / GitHub Actions / External Ping)
CRON_SECRET=

# ระบบตรวจสอบสลิปอัตโนมัติ (SlipOK / EasySlip API Key) - ตัวเลือกเสริม
SLIP_VERIFY_API_KEY=


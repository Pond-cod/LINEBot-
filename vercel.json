{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/webhook",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/reminder/trigger-now",
      "schedule": "0 1 * * *"
    }
  ]
}
